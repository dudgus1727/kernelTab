# syntax=docker/dockerfile:1.7
#
# kerneltab 컨테이너 이미지 — **초안이다. 아직 빌드하지 않았다.**
#
# 확장자를 .draft 로 둔 것은 의도적이다. 검증에 GPU 가 필요한데 GPU 는 전수
# 측정 중이라 아직 확인할 수 없다. 실수로 `docker build .` 이 잡아가지 않도록
# 파일명을 Dockerfile 로 두지 않았다.
#
# 빌드하기 전에 반드시 할 일:
#   1) docs/portability_audit.md 의 "수정 목록" 1~4 번을 먼저 적용할 것.
#      특히 so_path 절대경로 / GPU 인덱스 / env_hash 불안정 / 버전 미고정.
#      고치지 않으면 "실행은 되는데 데이터가 이상한" 상태가 된다.
#   2) 아래 BASE 다이제스트를 실제 값으로 채울 것 (지금은 자리표시자다).
#   3) requirements.lock 을 만들 것 (지금은 없다).
#
# ---------------------------------------------------------------------------
# 이 이미지가 담지 않는 것과 그 이유
# ---------------------------------------------------------------------------
# * NVIDIA 드라이버 — 담을 수 없다. libcuda.so.1 / libnvidia-ml.so 는 호스트
#   드라이버에서 오고 nvidia-container-toolkit 이 `--gpus` 로 주입한다.
#   따라서 **드라이버 버전은 컨테이너로 통일할 수 없다.** GPU 간 비교에서
#   남는 변수이므로 env.json 의 driver_version 을 반드시 함께 봐야 한다.
#
# * 컴파일된 커널 (.so) — 담지 않는다. 두 가지 이유다.
#     - 아키텍처가 박힌다. 커널은 `-arch=sm_86` 처럼 감지된 arch 로 빌드되므로
#       이미지에 넣으면 그 GPU 전용 이미지가 된다. "동일 이미지를 여러 GPU 에"
#       라는 전제가 무너진다.
#     - 크기가 폭발한다. sm_86 기준 7,330 개 x ~1 MB = 7.4 GB 다.
#   커널은 런타임에 빌드하고(30~40 분) /work/artifacts 볼륨에 남긴다.
#
# * results/ — 비워 둔다. 볼륨 마운트 지점이다. 마운트하지 않으면 컨테이너를
#   지울 때 측정 결과가 전부 사라진다. 선택이 아니라 필수다.
#
# * 클럭 고정 — 컨테이너 안에서 불가능하다. `nvidia-smi -lgc/-lmc` 는
#   CAP_SYS_ADMIN + 드라이버 쓰기 접근이 필요하고 컨테이너 툴킷은 주지 않는다.
#   호스트에서 미리 고정하고 `detect --externally-locked-mhz/-mem-mhz` 로
#   그 값을 인정받는다. 코드는 고정 실패를 graceful 하게 처리하므로 고정
#   없이도 돌아가지만, 그러면 드리프트 점검 주기가 10 분 -> 3 분으로 짧아지고
#   재현성이 나빠진다 (미고정 max 8.91% vs 고정 max 0.35%).

# ---------------------------------------------------------------------------
# BASE
# ---------------------------------------------------------------------------
# 태그(예: 12.4.1-devel-ubuntu22.04)는 같은 이름으로 내용이 바뀌므로 재현성이
# 없다. 반드시 다이제스트로 고정한다. 값은 아래로 얻는다:
#
#   docker buildx imagetools inspect nvidia/cuda:12.4.1-devel-ubuntu22.04 \
#       --format '{{.Manifest.Digest}}'
#
# TODO: 실제 다이제스트로 교체할 것. 아래는 자리표시자이며 그대로 빌드하면
#       실패한다 (일부러 그렇게 두었다 — 가짜 해시를 박아두면 언젠가 그것이
#       진짜인 줄 알고 쓰게 된다).
ARG BASE_IMAGE=nvidia/cuda@sha256:REPLACE_ME_WITH_REAL_DIGEST

# devel 이어야 한다. runtime 에는 nvcc / cuobjdump / nvdisasm 이 없다.
# CUDA 버전은 측정에 쓴 것과 맞춘다: 현재 데이터는 nvcc 12.4.99 로 만들었다.
# 상위 버전으로 올리면 커널 코드 생성이 달라질 수 있으므로 재측정 대상이다.
FROM ${BASE_IMAGE} AS base

ARG DEBIAN_FRONTEND=noninteractive

# git       : CUTLASS/kerneltab 커밋 기록에 필요. 없으면 재현성 추적이 끊긴다.
# python3   : ubuntu22.04 는 3.10. 개발은 3.13 에서 했으므로 3.10 실검증 필요
#             (docs/portability_audit.md 참조).
# ca-certificates : git clone https
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# CUTLASS — 커밋으로 고정
# ---------------------------------------------------------------------------
# 헤더 온리 라이브러리라 빌드하지 않는다. include/ 와 tools/util/include/ 만
# 쓴다. 다만 .git 을 남겨야 한다 — phase0 이 `git rev-parse HEAD` 로 커밋을
# 읽어 env.json 에 기록하기 때문이다. tarball 을 풀면 cutlass_commit=null 이
# 되어 "이 데이터가 어떤 CUTLASS 로 만들어졌는가" 를 잃는다.
ARG CUTLASS_COMMIT=d4b4b494c3c51bf6507e7ab09fbafd1e9fa94f39
RUN git clone --filter=blob:none https://github.com/NVIDIA/cutlass.git /opt/cutlass \
    && git -C /opt/cutlass checkout --detach ${CUTLASS_COMMIT}

# build/paths.py 가 /opt/cutlass 를 관례 위치로 탐색하지만, 명시하는 편이 낫다.
ENV KERNELTAB_CUTLASS_DIR=/opt/cutlass

# ---------------------------------------------------------------------------
# Python 의존성 — lock 파일로 고정
# ---------------------------------------------------------------------------
# pyproject.toml 의 `>=` 는 재현성이 없다. 6 개월 뒤 같은 Dockerfile 을
# 빌드하면 다른 버전이 들어온다. lock 으로 못 박는다.
#
# TODO: requirements.lock 을 만들 것. 현재 실측 버전:
#   nvidia-ml-py==13.610.43
#   pyarrow==25.0.1
# (pandas 는 선언되어 있지만 어디서도 쓰지 않는다 — 제거 대상)
COPY requirements.lock /tmp/requirements.lock
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.lock

# ---------------------------------------------------------------------------
# kerneltab 소스
# ---------------------------------------------------------------------------
WORKDIR /work
COPY core/       /work/core/
COPY backends/   /work/backends/
COPY build/      /work/build/
COPY measure/    /work/measure/
COPY hwspec/     /work/hwspec/
COPY scripts/    /work/scripts/
COPY pyproject.toml README.md /work/

# .git 을 넣어야 kerneltab_commit 이 기록된다. 넣지 않으려면 빌드 인자로
# 커밋을 주입하고 manifest.py 가 그것을 읽게 해야 한다 (미구현).
ARG KERNELTAB_COMMIT=unknown
ENV KERNELTAB_COMMIT=${KERNELTAB_COMMIT}

# 산출물 경로. 둘 다 **쓰기 가능해야 하고 볼륨이어야 한다.**
#   results   : 측정 결과 (append-only jsonl). 날리면 40 시간을 다시 쓴다.
#   artifacts : 커널 .so 7.4 GB + 생성된 .cu. 날리면 30~40 분 재빌드.
# TODO: 코드가 아직 이 환경변수를 읽지 않는다 (build/paths.py 는 REPO_ROOT
#       기준으로 고정). portability_audit 수정 6 번.
ENV KERNELTAB_RESULTS_DIR=/work/results \
    KERNELTAB_ARTIFACT_DIR=/work/artifacts
RUN mkdir -p /work/results /work/artifacts
VOLUME ["/work/results", "/work/artifacts"]

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/work

# ---------------------------------------------------------------------------
# ENTRYPOINT
# ---------------------------------------------------------------------------
# docs/entrypoints.md 의 단일 CLI 설계안이 구현되면 아래로 바꾼다:
#   ENTRYPOINT ["python3", "-m", "kerneltab"]
#   CMD ["status"]
#
# 지금은 스크립트가 흩어져 있으므로 shim 이 필요하다. 임시로는 아래처럼 쓴다:
#   docker run ... $IMG python3 scripts/phase0_env.py --device 0 ...
ENTRYPOINT ["python3"]
CMD ["scripts/manifest.py"]

# ---------------------------------------------------------------------------
# 사용 예 (호스트에서)
# ---------------------------------------------------------------------------
# # 0) 클럭 고정 — 컨테이너 안에서는 불가능하다
# sudo nvidia-smi -i 3 -pm 1
# sudo nvidia-smi -i 3 -lgc 1350,1350
# sudo nvidia-smi -i 3 -lmc 8001
#
# # 1) 빌드 (다이제스트와 lock 을 채운 뒤)
# TAG=$(python3 scripts/manifest.py --tag)          # kerneltab:cu124-xxxxxxxx
# docker build -f docker/Dockerfile.draft \
#     --build-arg KERNELTAB_COMMIT=$(git rev-parse HEAD) \
#     -t $TAG .
#
# # 2) 실행. --gpus 로 준 GPU 는 컨테이너 안에서 index 0 으로 보인다.
# #    따라서 --device 3 같은 인덱스를 넘기면 안 된다 (audit P-2).
# VOL="-v $PWD/results:/work/results -v $PWD/artifacts:/work/artifacts"
# docker run --rm --gpus '"device=3"' $VOL $TAG \
#     scripts/phase0_env.py --device 0 \
#         --externally-locked-mhz 1350 --externally-locked-mem-mhz 7601
# docker run --rm --gpus '"device=3"' $VOL $TAG \
#     scripts/build_kernels.py --align a888,a448 --jobs 40
# docker run --rm --gpus '"device=3"' $VOL $TAG scripts/rehearse.py --all
# docker run --rm                     $VOL $TAG scripts/export.py
#
# # 3) 정리
# sudo nvidia-smi -i 3 -rgc && sudo nvidia-smi -i 3 -rmc
#
# ---------------------------------------------------------------------------
# 이미지 태그 규칙
# ---------------------------------------------------------------------------
# `latest` 는 쓰지 않는다. 태그는 (CUDA 버전 + 매니페스트 해시) 로 조합을
# 식별한다. 매니페스트 해시는 nvcc/CUTLASS 커밋/kerneltab 소스 트리 해시/
# Python 패키지 버전을 담는다 (scripts/manifest.py).
#
#   kerneltab:cu124-9b70b430
#
# 소스가 한 글자라도 바뀌면 tree_hash 가 바뀌고 태그가 바뀐다. 즉 태그만 보면
# "이 데이터가 어떤 코드로 만들어졌는가" 가 결정된다.
